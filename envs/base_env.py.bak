    #     pass

    def _reset(self):
        """Whenever we update the subscriptions, we also have to clear
        logging buffers."""
        self.beam_current = None
        self.beam_params = None
        self.actor_values = None


    def _update_bsc_scale(self, bsc_addr, sensitivity_level):
        # Initial state
        current_state = "initial"

        bsc_addr = bsc_addr.replace("Acquisition", "Setting#sensitivity")

        def __sensitivity__BSC70(bsc_addr, value):
            return utl.utils_pjlsa.set_scalar(bsc_addr, value)

        counts1 = 0
        counts2 = 0
        counts3 = 0
        counts4 = 0
        counts5 = 0
        counts6 = 0

        while current_state != "output":
            if current_state == "initial":
                print(current_state)
                label = sensitivity_level
                if label == 5:
                    current_state = "sen1"
                elif label == 4:
                    current_state = "sen2"
                elif label == 3:
                    current_state = "sen3"
                elif label == 2:
                    current_state = "sen4"
                elif label == 1:
                    current_state = "sen5"
                elif label == 0:
                    current_state = "sen6"

            elif current_state == "sen1":
                print(current_state)
                label = 5
                counts1 = counts1 + 1
                __sensitivity__BSC70(bsc_addr, label)
                time.sleep(7)
                self._get_next_bsc_observations()
                measures0 = self.beam_params["hor_max_mean"]
                measures1 = self.beam_params["ver_max_mean"]
                print("peaks", measures0[-1], measures1[-1])
                if (measures0[-1] >= 2000 or measures1[-1] >= 2000) and counts1 <= 1:
                    current_state = "sen2"
                elif measures0[-1] < 2000 and measures1[-1] < 2000 or counts1 > 1:
                    current_state = "scale1"

            elif current_state == "sen2":
                print(current_state)
                counts2 = counts2 + 1
                label = 4
                __sensitivity__BSC70(bsc_addr, label)
                time.sleep(7)
                self._get_next_bsc_observations()
                measures0 = self.beam_params["hor_max_mean"]
                measures1 = self.beam_params["ver_max_mean"]

                if (measures0[-1] >= 2000 or measures1[-1] >= 2000) and counts2 <= 1:
                    current_state = "sen3"
                elif (measures0[-1] < 2000 and measures1[-1] < 2000) and (
                        measures0[-1] >= 200 or measures1[-1] >= 200) or counts2 > 1:
                    current_state = "scale1"
                elif (measures0[-1] < 200 and measures1[-1] < 200) and counts2 <= 1:
                    current_state = "sen1"

            elif current_state == "sen3":
                print(current_state)
                counts3 = counts3 + 1
                label = 3
                __sensitivity__BSC70(bsc_addr, label)
                time.sleep(7)
                self._get_next_bsc_observations()
                measures0 = self.beam_params["hor_max_mean"]
                measures1 = self.beam_params["ver_max_mean"]

                if (measures0[-1] >= 2000 or measures1[-1] >= 2000) and counts3 <= 1:
                    current_state = "sen4"
                elif (measures0[-1] < 2000 and measures1[-1] < 2000) and (
                        measures0[-1] >= 200 or measures1[-1] >= 200) or counts3 > 1:
                    current_state = "scale1"
                elif (measures0[-1] < 200 and measures1[-1] < 200) and counts3 <= 1:
                    current_state = "sen2"

            elif current_state == "sen4":
                print(current_state)
                counts4 = counts4 + 1
                label = 2
                __sensitivity__BSC70(bsc_addr, label)
                time.sleep(7)
                self._get_next_bsc_observations()
                measures0 = self.beam_params["hor_max_mean"]
                measures1 = self.beam_params["ver_max_mean"]

                if (measures0[-1] >= 2000 or measures1[-1] >= 2000) and counts4 <= 1:
                    current_state = "sen5"
                elif (measures0[-1] < 2000 and measures1[-1] < 2000) and (
                        measures0[-1] >= 200 or measures1[-1] >= 200) or counts4 > 1:
                    current_state = "scale1"
                elif (measures0[-1] < 200 and measures1[-1] < 200) and counts4 <= 1:
                    current_state = "sen3"

            elif current_state == "sen5":
                print(current_state)
                counts5 = counts5 + 1
                label = 1
                __sensitivity__BSC70(bsc_addr, label)
                time.sleep(7)
                self._get_next_bsc_observations()
                measures0 = self.beam_params["hor_max_mean"]
                measures1 = self.beam_params["ver_max_mean"]
                if (measures0[-1] >= 2000 or measures1[-1] >= 2000) and counts5 <= 1:
                    current_state = "sen6"
                elif (measures0[-1] < 2000 and measures1[-1] < 2000) and (
                        measures0[-1] >= 200 or measures1[-1] >= 200) or counts5 > 1:
                    current_state = "scale1"
                elif (measures0[-1] < 200 and measures1[-1] < 200) and counts5 <= 1:
                    current_state = "sen4"

            elif current_state == "sen6":
                print(current_state)
                counts6 = counts6 + 1
                label = 0
                __sensitivity__BSC70(bsc_addr, label)
                time.sleep(7)
                self._get_next_bsc_observations()
                measures0 = self.beam_params["hor_max_mean"]
                measures1 = self.beam_params["ver_max_mean"]
                if measures0[-1] >= 200 or measures1[-1] >= 200 or counts6 > 1:
                    current_state = "scale1"
                elif (measures0[-1] < 200 and measures1[-1] < 200) and counts6 <= 1:
                    current_state = "sen5"

            elif current_state == "scale1":
                print(current_state)
                flag_t = True
                final_f = True
                measures4 = self.beam_params["hor_mu_mean"]
                measures5 = self.beam_params["ver_mu_mean"]
                measures6 = self.beam_params["hor_sigma_mean"]
                measures7 = self.beam_params["ver_sigma_mean"]

                if flag_t:
                    current_state = "output"

                    # Output state
        result = np.array(
            [measures4[-1], measures5[-1], measures6[-1], measures7[-1]])
        return result