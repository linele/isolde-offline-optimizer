        "cern.cancellable": True,
    }
    _env_name: str = "IsoldeOfflineEnv"
    _target: str = ""
    _data_dir: Path = Path("./")
    _tapestation_field: str = "measurement1Count"

    taus = np.array([0, 0, 0, 0])
    n_constraints = len(taus)
    constraints_values = np.zeros(n_constraints)

    @classmethod
